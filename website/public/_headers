# Cloudflare Pages response headers for the FoodOS.ai marketing site.
# Owned by DevOps (FOO-4). Docs: https://developers.cloudflare.com/pages/configuration/headers/
#
# This file is copied verbatim from `public/` into `dist/` by Vite and is read
# by Pages at the edge. It does NOT apply to Pages Functions responses
# (`/api/*`) — those set their own headers in website/functions/.
#
# IMPORTANT for Frontend: the script CSP below has no 'unsafe-inline'. Vite's
# module-preload polyfill emits an INLINE <script>, which this CSP blocks. Set
# `build: { modulePreload: { polyfill: false } }` in vite.config.ts (safe for
# the browsers we target — all support modulepreload), or tell DevOps and we
# will switch to a hash-based allowance. Verify with the browser console on a
# preview deploy before enabling the custom domain.

/*
  # --- Transport ---
  # 1 year. Only added here because Pages is HTTPS-only; `preload` is safe to
  # keep since foodos.ai is a fresh domain served entirely by Cloudflare.
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # --- Framing / sniffing / referrers ---
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

  # --- Feature access: deny everything the marketing site never uses ---
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=(), xr-spatial-tracking=()

  # --- Content Security Policy ---
  # Allowed third parties, and why:
  #   challenges.cloudflare.com    Turnstile widget script + its iframe
  #   static.cloudflareinsights.com  Cloudflare Web Analytics beacon script
  #   cloudflareinsights.com       Web Analytics beacon endpoint (fetch)
  # The design ships with no external fonts and no CDNs, so nothing else is
  # permitted. Adding a font or CDN means editing this line.
  # 'unsafe-inline' on style-src is required: React inline styles and the
  # Turnstile widget both inject styles at runtime.
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://challenges.cloudflare.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://challenges.cloudflare.com https://cloudflareinsights.com; frame-src https://challenges.cloudflare.com; manifest-src 'self'; upgrade-insecure-requests

# Vite emits content-hashed filenames into /assets/, so these are immutable.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Never let a stale shell be cached: it references hashed asset URLs.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Belt and braces — the Function should set this too, but if it ever 500s
# through the static handler we still don't want a cached API response.
/api/*
  Cache-Control: no-store
