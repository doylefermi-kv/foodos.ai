{
  // Pages Functions (Backend Engineer). These run on the Workers runtime, not
  // in the browser and not in Node, so they get their own project: Workers
  // globals instead of DOM, and no JSX.
  //
  // Added by DevOps (FOO-4) because `tsconfig.app.json` only includes `src`
  // and `shared` — without this project, `npm run typecheck` would pass while
  // `functions/` had type errors, and the first sign of trouble would be a
  // failed deploy.
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.functions.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022"],
    // `node` is here only for the tests, which use the built-in `node:test`
    // runner. The Functions themselves must not import Node built-ins unless
    // `nodejs_compat` is on in wrangler.toml.
    "types": ["@cloudflare/workers-types", "node"],
    "module": "ESNext",
    "moduleResolution": "bundler",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,

    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  // `shared` is included so the Functions can import the contract types that
  // the frontend also uses — one definition, checked in both projects.
  "include": ["functions", "shared"]
}
