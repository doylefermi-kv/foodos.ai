# --- Secrets: never commit anything from this block ---------------------------
# Wrangler local dev secrets (website/.dev.vars). The .example file is tracked.
.dev.vars
.dev.vars.*
!.dev.vars.example
.env
.env.*
!.env.example
# Google service-account keys. Real keys live only in Cloudflare secrets.
*service-account*.json
*-key.json
*.pem
*.p12
credentials.json

