# --- Secrets: never commit anything from this block ---------------------------
# Local build-time env (website/.env). `.env.example` is the tracked template;
# everything in it is public by design — VITE_* values ship in the bundle.
.env
.env.*
!.env.example
# `.dev.vars` was wrangler's local secret file. Wrangler is gone (FOO-6) and so
# is the file, but the pattern stays: it costs nothing and the day someone
# recreates one is exactly the day this would have mattered.
.dev.vars
.dev.vars.*
# Google service-account keys. Not used any more either — the Apps Script runs
# as the sheet's owner, so there is no key to hold — but same reasoning.
*service-account*.json
*-key.json
*.pem
*.p12
credentials.json

# --- Build output -------------------------------------------------------------
dist/
build/
.vite/
*.tsbuildinfo

# --- Dependencies ---------------------------------------------------------------
node_modules/
.pnp
.pnp.js

# --- Test / tooling output ------------------------------------------------------
coverage/
.nyc_output/
.eslintcache
playwright-report/
test-results/

# --- Logs -----------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Editor / OS ----------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# --- Local agent / tooling scratch ----------------------------------------------
.claude/settings.local.json
